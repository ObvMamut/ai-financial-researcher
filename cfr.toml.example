# Claude Financial Researcher configuration.
#
# Copy to ./cfr.toml (project-local) or ~/.config/cfr/config.toml (global).
# Precedence, lowest to highest: built-in defaults → ~/.config/cfr/config.toml
# → ./cfr.toml → environment variables (CFR_*) → command-line flags (headless).
# Every key is optional; omit anything to keep the default.

# Opt-in company-by-company research and challenge for 10–15 trading sessions.
# Default remains legacy. Env: CFR_RESEARCH_MODE; headless: --research-mode thesis.
#research_mode = "legacy"

# Where run artifacts (reports, ideas.json, prices/, quant.json) are written.
#runs_dir = "runs"

# Where agent persona prompts live.
#agents_dir = "agents"

# Cache directory for market data (daily-keyed Yahoo responses).
#data_dir = ".data"

# How many past run directories to keep (the scoreboard reads this history).
#keep_runs = 100

# How long a cached daily price series is served before being refetched. Every
# entry, stop and target is computed to the cent off the last close, so a cache
# scoped only to the calendar day priced a Saturday run off Thursday's bar.
#price_ttl = "4h"

# How long cached provider responses survive the run-start janitor. Keys are
# date-scoped, so older entries can never be read again — they only accumulate.
# 0 disables pruning.
#data_cache_days = 7

# Bounded worker pool size for parallel agent subprocesses.
#workers = 4

# ── Funnel geometry ──────────────────────────────────────────────────────────
# Stage 0.5 ranks every constituent of the selected indices on a computed quant
# composite before any model is called; the scouts screen that ranking.

# How many of each index's highest-composite names the scout's Continuation table
# shows. The five weakest are always appended as a Weakest section.
#
# The scout reads six tables, not one, because the composite is built entirely
# from trailing returns and its top is therefore, by construction, the names that
# have already run the furthest. Screening only that top is how a single run came
# to propose three longs sitting at 0.993, 0.982 and 1.000 of their 52-week
# highs. Alongside Continuation the pre-screen classifies and shows:
#
#   pullback — the composite and the last month disagree: an uptrend currently
#              dipping (0.80-0.95 of the 52-week high, vol not expanding), or a
#              downtrend currently bouncing, which is where a fresh short lives
#   base     — 20-day realized vol under 90% of the 60-day while price goes
#              nowhere; the one shape that cannot be extended by construction
#
# The archetypes are disjoint filters, first match wins, and each is ranked by
# the same trend composite so the merge can compare across them.
#
# The two counter-trend archetypes are rendered as a long half and a short half,
# and these keys count rows **per half** (so 5 means up to ten pullback rows).
# One section ranked by the composite is a long-only section whatever the
# classifier found, because the composite's sign *is* the direction: a bearish
# candidate's merit is -score, so the best shorts carry the most negative scores
# and sit at the far end of a best-first walk. Before the split, 32 bearish
# pullbacks existed across four indices and 8 were shown; sp500 showed 0 of its
# 11 and its scout nominated six longs and no shorts.
# The eighth and ninth sections are the earnings-drift halves, and they are the
# only ones not built from trailing returns. A name that filed a 10-Q or 10-K
# inside the last trading month and repriced on it is shown with the abnormal
# two-session reaction (`gapZ`, in units of its own daily vol) and that reaction
# decayed toward the end of the window (`drift`).
#
# They exist because every other term on this page is a return over three or
# twelve months. Those are real cross-sectional factors and they are right about
# the next quarter or the next year; this system holds for two or three weeks.
# Post-earnings drift is the one well-documented effect on that clock, so it is
# the only input in the funnel whose horizon matches the question being asked.
#
# The split is by the sign of the *reaction*, not of the composite, because the
# two often disagree — a name that rallied all year and then missed is a short
# sitting at the top of the ranking, which no trailing-return table can surface.
# The merge follows suit: a drift candidate is ranked on its drift rather than on
# the composite (internal/orchestrator/prescreen.go, meritComposite), since
# aligning it to the composite would give the best short a large negative merit
# and delete it — exactly what happened to the pullback archetype before
# shortlist_reserve was added.
#
# Only US filers appear: the report date comes from SEC's daily index, so a
# foreign listing with no US line has no drift signal rather than a wrong one.
# The leg is additive and needs [providers] contact_email — without it, or if SEC
# is unreachable, the ranking is exactly what it was before.
# Two further sections are the earnings-drift halves, and they are the only ones
# not built from trailing returns. A name that filed a 10-Q or 10-K inside the
# last trading month and repriced on it is shown with the abnormal two-session
# reaction (`gapZ`, in units of its own daily vol) and that reaction decayed
# toward the end of the window (`drift`).
#
# They exist because every other term on this page is a return over three or
# twelve months. Those are real cross-sectional factors and they are right about
# the next quarter or the next year; this system holds for two or three weeks.
# Post-earnings drift is the one well-documented effect on that clock, so it is
# the only input in the funnel whose horizon matches the question being asked.
#
# The split is by the sign of the *reaction*, not of the composite, because the
# two often disagree — a name that rallied all year and then missed is a short
# sitting at the top of the ranking, which no trailing-return table can surface.
# The merge follows suit: a drift candidate is ranked on its drift rather than on
# the composite (meritComposite in internal/orchestrator/prescreen.go), since
# aligning it to the composite would give the best short a large negative merit
# and delete it — exactly what happened to the pullback archetype before
# shortlist_reserve was added.
#
# Only US filers appear: the report date comes from SEC's daily index, so a
# foreign listing with no US line carries no drift signal rather than a wrong
# one. The leg is additive and needs [providers] contact_email — without it, or
# if SEC is unreachable, the ranking is exactly what it was before.
#prescreen_top_per_index = 15
#prescreen_pullback_per_index = 5
#prescreen_base_per_index = 3
#prescreen_drift_per_index = 5
#prescreen_drift_per_index = 5

# Cap on the merged shortlist that reaches the specialists, and on how many of
# those names one index may contribute before the merit backfill.
#max_shortlist = 12
#max_per_index = 5

# Cap on shortlisted names the run's sources can ground less than 60% of the
# domain weight for. SEC filings and listed option chains are US instruments, so
# fundamentals, sentiment and news cannot reach a non-US listing with no US
# line; quant and macro, computed from the name's own bars, can reach any
# listing. So an unmapped foreign name expects 0.45 of the weight, under the 0.6
# floor. Unlike max_per_index this cap is hard: the merit backfill respects it,
# so a shortlist can come back shorter than max_shortlist rather than filled with
# names three of the five domains must abstain on.
#
# It was max_quant_only, a count of names *no* provider could reach — true of
# nothing, and in a unit unrelated to the base score. The replacement was then
# dead for a different reason: news was counted as global on the strength of a
# keyless headline search that takes the local symbol, which put every listing at
# 0.70 and left nothing under the floor. On 2026-09-03 that search answered all
# five unmapped foreign names with the same eight untagged stories, the domain
# recorded every one as missing, metadata.json read "thinly_covered": null, and
# three of the five shipped ideas were scored by one domain or two.
#
# The default is now **0** — admit none of them — because such a name cannot
# reach the output at all: macro carries zero weight, so an unmapped foreign
# listing expects exactly quant's 0.35, and the risk gate's evidence floor
# deletes an idea scored by quant alone. The cap was not admitting weaker
# research, it was admitting candidates guaranteed to be deleted and paying for
# them in shortlist slots and specialist reports. On 2026-09-05 it seated exactly
# its four — 051910.KS, BAYN.DE, BMW.DE, DSFIR.AS took a third of the shortlist,
# News, Fundamentals and Sentiment returned nothing for any of them, all four
# were dropped, and the run shipped two ideas. Set a **negative** value to
# disable the cap; a positive one raises it.
#max_thinly_covered = 0

# Slots held in the shortlist for names that are *not* the continuation
# archetype, and the merit a candidate needs (in the composite's own z units) to
# take one. Set shortlist_reserve to a negative number to disable the reserve and
# restore the pure merit sort.
#
# It exists because merit *is* the pre-screen composite, and the composite
# rewards having already run — so left alone the merit sort undoes the archetypes
# entirely, computing them, showing them to the scout, and then dropping every
# one. The reserve is soft in only one direction: a reserved slot is filled only
# by a candidate that also clears the merit floor, so a run with no decent
# pullback ships a shorter shortlist rather than a padded one.
#shortlist_reserve = 3
#shortlist_reserve_min_merit = 0.5

# How far, in confidence points, the Chief Analyst may move an idea from its
# computed base score (docs/workflow/scoring.md). Confidence outside the band is
# clamped; more than twice the band out triggers one corrective re-prompt.
#chief_adjust_band = 10

# Default indices screened by independent research (empty/omitted = all four).
# Valid keys: sp500, nq100, eu50, asia100. The TUI picker overrides this per run.
#indices = ["sp500", "eu50"]

# Max simultaneous Gemini (agy) subprocesses. Keep at 1 unless your OS keyring
# tolerates concurrent auth (contention escalates to a browser login). Ignored
# when cheap_engine = "api" (the HTTP engine has no keyring and parallelizes freely).
#gemini_concurrency = 1

# Which engine runs the cheap-research roles (scouts + the 5 specialists):
#   "gemini" — the `agy` CLI (default; no key needed)
#   "api"    — a remote OpenAI-compatible HTTP endpoint (see [api] below).
#              Recommended if `agy`/Gemini is unreliable for you.
#   "local"  — a local OpenAI-compatible server such as Ollama (see [local] below).
#              Free and offline; needs a GPU/CPU that can serve the model.
# The heavy Chief Analyst synthesis primarily uses the `claude` CLI, so the
# cheap/heavy split is preserved whichever cheap engine you pick — the one
# reviewed exception is the off-by-default [chief_fallback] resilience engine
# below, which only fires if that primary call fails.
#cheap_engine = "gemini"

# Max simultaneous local-model calls (cheap_engine = "local"). One GPU can't run
# the 5 specialists at once, so keep this at 1 unless you have plenty of VRAM.
#local_concurrency = 1

# Domain weights for confluence scoring; they are renormalized, so only the
# ratios matter. Defaults are mapped to the 5-20 trading-day horizon: quant leads
# because it is the only fully-covered, computed, horizon-matched domain, and
# fundamentals is demoted because a multiple says little about three weeks and is
# the worst-covered domain (US filers only, quarterly, often stale).
#
# Macro defaults to **zero**, and that is not the same as switching it off. It
# still runs, and its regime read still reaches the Chief Analyst; it just does
# not vote.
#
# A regime is one fact about a market shared by every name that trades in it, and
# this prompt asks about a dozen names from three or four markets. Scored per
# name, one fact became twelve, and the arithmetic downstream could not tell the
# difference — it read them as twelve independent confirmations. Worse, the
# persona asked whether the regime supported each name's *nominated* direction,
# a question a screen-chosen direction can only be answered "yes" to: across the
# last three stored runs this domain agreed with the nomination on 12 of 12 names
# every time, correlating 0.85-0.99 with the quant domain, which reads the same
# price history the nomination came from. Ten per cent of the weight was the
# pre-screen composite agreeing with itself, and because a regime read needs no
# filing and no option chain it was the vote that carried the *thinly covered*
# names: two of the five ideas shipped on 2026-09-04 were scored by quant and
# macro alone and reported 100% agreement.
#
# Setting it above zero restores all of that. If you do, expect the `agree`
# column to stop meaning anything and unresearched foreign listings to clear the
# thin-coverage floor again.
#[weights]
#quant        = 0.35
#news         = 0.30
#fundamentals = 0.18
#sentiment    = 0.17
#macro        = 0.00

# Per-stage subprocess timeouts (Go duration strings). Each is a per-attempt
# budget, never divided across retries. Synthesis is 15m by default — every
# real run to date SIGKILLed the Chief Analyst at the old 5m default (601s ≈ 2
# attempts x 300s) with no data yet on how long an uninterrupted call takes.
#[timeouts]
#screening = "5m"
#analysis  = "8m"
#synthesis = "15m"
#synthesis_fallback = "15m"   # empty/unset = same as synthesis

# Subprocess retry policy. max_attempts governs screening/analysis and the
# chief_fallback call's own transient-error (429/5xx) retries.
#[retry]
#max_attempts = 2
#base_delay   = "2s"
#max_delay    = "30s"
#jitter       = true
# The primary Chief Analyst call gets its own budget instead of max_attempts: a
# timeout there means "too slow," not "flaky," so retrying identically just
# delays reaching chief_fallback below.
#synthesis_max_attempts = 1

# Model names passed to each CLI via --model.
#[models]
#claude = "opus"
#gemini = ""

# CLI executables (same as CFR_CLAUDE_BIN / CFR_GEMINI_BIN).
#[binaries]
#claude = "claude"
#gemini = "agy"

# OpenAI-compatible cheap-research engine (used when cheap_engine = "api"). This
# is the recommended replacement if `agy`/Gemini stops working. It speaks the
# standard /chat/completions protocol, so it works with DeepSeek, OpenRouter,
# OpenAI, or a local vLLM/Ollama gateway — just change base_url + model. Only the
# cheap roles use it; the Chief Analyst still synthesises via the `claude` CLI.
# The agy keyring throttle does NOT apply here, so the 5 specialists run in
# parallel — set workers >= 5 to run them all at once.
# Put the key in the CFR_API_KEY env var (or DEEPSEEK_API_KEY); avoid committing
# it to this file.
#[api]
#base_url = "https://api.deepseek.com"   # up to, not including, /chat/completions
#model    = "deepseek-chat"
#api_key  = ""                            # prefer CFR_API_KEY / DEEPSEEK_API_KEY env
# Completion cap. A response cut off at the provider's default limit loses its
# structured tail, which the pipeline read as "this domain scored nobody"; the
# engine now treats finish_reason=length as a failure and retries.
#max_tokens = 8192

# Local OpenAI-compatible server (used when cheap_engine = "local"). Same engine
# as [api], just pointed at your machine — free and offline. Easiest server is
# Ollama (`ollama serve` → http://localhost:11434/v1); llama.cpp/LM Studio/vLLM
# work too by changing base_url. No key needed (local servers don't authenticate).
# On ~4 GB VRAM a Q4 7–8B instruct model is the sweet spot; confirm with nvidia-smi.
#[local]
#base_url = "http://localhost:11434/v1"   # Ollama's OpenAI-compatible endpoint
#model    = "qwen2.5:7b-instruct"         # must match a model you've pulled
#api_key  = ""                            # optional; ignored by most local servers

# Optional Chief Analyst resilience fallback (same apiengine.go engine as [api]/
# [local]). Off by default — set only once you've decided to accept this
# reviewed exception to the CLI-only synthesis rule. Fires only after the
# primary `claude` call has exhausted synthesis_max_attempts or its JSON failed
# to parse, and sits strictly before the mechanical degraded-ideas fallback
# (docs/workflow/scoring.md, "Degraded path"). Needs its OWN dedicated key —
# deliberately never shared with [api]/[local], so turning those on can never
# silently also enable this spend. Put the key in CFR_CHIEF_FALLBACK_API_KEY
# rather than committing it here (no DEEPSEEK_API_KEY alias, unlike [api]).
#[chief_fallback]
#base_url = "https://api.deepseek.com"
#model    = "deepseek-reasoner"          # a smarter tier than the cheap role's deepseek-chat
#api_key  = ""                            # prefer CFR_CHIEF_FALLBACK_API_KEY; never share with [api]
# deepseek-reasoner spends tokens on chain-of-thought before its answer, so this
# needs real headroom — 4x the cheap role's default.
#max_tokens = 32768

# No-API alternative: run the cheap role on the `claude` CLI at a cheap tier.
# Keep cheap_engine = "gemini" and just swap the "gemini"-role binary+model —
# this preserves the cheap/heavy split (Haiku for the parallel research calls,
# Opus for the single Chief Analyst synthesis):
#   [binaries]
#   gemini = "claude"
#   [models]
#   gemini = "haiku"
# The agy keyring-contention reason is then gone, so raise gemini_concurrency > 1.

# ── Risk limits ──────────────────────────────────────────────────────────────
# Enforced in Go after synthesis (docs/workflow/scoring.md). Every one of these
# was a preference in a persona before it was a number here, and a model asked
# for "usually 1-2 sigma" and "risk_reward >= 1.5 preferred" answers at the
# cheapest edge of the band.
#[risk]

# Every key in this block is presence-detected: a value you write here is used
# at exactly the value you wrote, including 0, and only a key you leave out
# takes its default. `cost_bps = 0` therefore prices the book frictionless and
# `rr_min = 0` turns the reward:risk floor off, where before either one was
# silently replaced by the default and there was no way to say them at all. The
# CFR_* overrides below behave the same way.
#
# The exception is the four ceilings and the two sizing inputs — account_equity,
# risk_per_trade_pct, stop_sigma_max, target_sigma_max, max_pair_corr,
# max_portfolio_beta and max_per_sector. Zero is how you disable a floor, but a ceiling of zero
# rejects every idea rather than disabling anything, so setting one to 0 (or
# negative) is refused at startup instead of being honoured or quietly ignored.
# edge_sigma_daily, min_expectancy_r and min_expectancy_bps accept a negative
# value on purpose: a losing system has a negative edge, and a negative floor is
# a weaker floor.
#
# The sigma band is also checked for ordering, once the defaults below are
# filled: stop_sigma_min above stop_sigma_max, or target_sigma_max below
# stop_sigma_min, fails the run at startup. Setting just one side counts —
# stop_sigma_min = 2.5 crosses the default stop_sigma_max of 2.0 — and an
# inverted band otherwise loads clean and then drops every idea at the risk
# gate, which reads like a run that simply found nothing worth trading.

# Position sizing. Currency at risk per trade = account_equity x
# risk_per_trade_pct / 100; shares = that divided by the stop distance, with any
# one position capped at 25% of equity.
#account_equity      = 100000
#risk_per_trade_pct  = 0.5

# Round-trip cost assumption (spread + commission + slippage) for a name at the
# liquidity floor below. It is scaled down for more liquid names — a mega-cap
# does not pay a $20M-a-day listing's spread — so this is a ceiling rather than a
# flat charge. See costTiers in internal/orchestrator/riskgate.go.
#cost_bps = 30

# Hard geometry limits, in units of sigma_daily x sqrt(timeframe_days).
#rr_min           = 1.8
#stop_sigma_min   = 1.0
#stop_sigma_max   = 2.0
#target_sigma_max = 3.5

# How far a limit entry may sit from the verified last close, in units of
# sigma_daily x sqrt(5). The band is asymmetric because the two sides are not the
# same trade: a long bidding *below* the close (or a short offering above it) is
# waiting for a better price, and the worst case is that the limit never trades —
# which the scoreboard records as `unfilled`, not as a loss. A long bidding above
# the close is chasing, and the worst case there is a filled position at the top
# of the move.
#
# One number could only ever be set to the chasing width. That is why a run bid
# 442 for a stock at 444.12 sitting on its 52-week high: waiting for a genuine
# pullback was not expressible.
#entry_patience_sigma = 1.5
#entry_chase_sigma    = 0.5

# 20-day average dollar volume below which a name is not tradeable in size. The
# pre-screen drops anything under it, so such names never reach a model, and the
# gate rejects any that slip through.
#adv_min_usd = 20000000

# Book-level limits: pairwise return correlation above which two same-direction
# ideas are one position, and the bound on the book's beta-adjusted exposure —
# Σ|beta × notional| / account_equity for the gross limit and the signed sum for
# the net one, both read as a multiple of the account. It used to be a per-idea
# *average*, which any low-beta name could dilute: on 2026-09-03 a book that
# failed at 1.62 was fixed by dropping a five-domain idea for a quant-only one
# whose only merit was a low beta. Every position adds to the new figure, so the
# only way down is to drop or shrink the exposure itself.
#max_pair_corr      = 0.75
#max_portfolio_beta = 1.5

# How many of the shipped ideas may share a sector before the book is one bet in
# several tickets. It was a private constant in the risk gate, which meant the
# funnel selecting the shortlist had no way to know the limit it was feeding: on
# 2026-09-05 the merit sort returned a shortlist seven-twelfths Information
# Technology, seven of the eight names that cleared the evidence floor were IT,
# and this limit then cut the book to two ideas. The shortlist's own sector cap
# is derived from this — one higher, so the gate has something to choose between
# rather than only something to truncate — so raising it loosens both together.
#max_per_sector = 2

# Daily expected return assumed in the expectancy simulation, in units of
# sigma_daily. It has to be small: a driftless simulation puts every geometry at
# about minus costs, and an optimistic one puts every geometry comfortably
# positive. Measured across the geometries the bands permit, 0.05 puts all of
# them between +97 and +149bps (the check never fires); 0.02 spreads them from
# +10 to +64bps. Once 30 ideas have closed, the scoreboard's measured average R
# replaces this prior entirely and the value below stops being used.
#edge_sigma_daily = 0.02

# Simulated expectancy floor, as a multiple of the trade's own risk and net of
# costs. This is the gate's expectancy test.
#
# It replaced a floor in basis points of entry, which was proportional to the
# stop distance and so graded volatility rather than construction: on 2026-09-01
# five ideas with near-identical geometry (stop ~1.3σ, target ~2.6σ, R:R ~1.9)
# scored +28.7 down to −3.1bps in exact order of σ_daily, and the three calmest
# were dropped. The floor sits just clear of the simulation's own error (about
# 0.001R) and no higher: the *level* of this distribution is set by the assumed
# edge below, and a floor placed inside an assumption measures the assumption.
#min_expectancy_r = 0.005

# A secondary floor in basis points of entry, default 0 — which refuses only a
# geometry that loses money outright, the one verdict that figure can carry on
# its own. Set it if you want the old test back as well.
#min_expectancy_bps = 0

# Thesis research budgets. Extra challenger/revision calls use the cheap engine;
# Claude CLI remains the final selector. No paid search provider is required.
# See docs/workflow/thesis-research.md for evidence and calendar limitations.
#[research]
#rounds = 3          # 1–6 ordinary rounds, plus at most one challenge revision
#documents = 8       # 1–32 document/filing retrieval attempts per company
#candidates = 24     # 1–48 names from alternating event and price lanes
#shortlist = 12      # 1–candidates; independent per-company research loops
#sources_file = ""   # optional ticker,url CSV for additional public issuer pages
#holidays_file = ""  # optional ticker,date CSV; markets outside bundled coverage remain estimated
# Env: CFR_RESEARCH_ROUNDS / DOCUMENTS / CANDIDATES / SHORTLIST /
# SOURCES_FILE / HOLIDAYS_FILE (each with the CFR_RESEARCH_ prefix).

# How past ideas are replayed by `cfr scoreboard`.
#[scoreboard]
# Sessions an idea's entry limit stays live before the idea counts as unfilled
# rather than as a trade. Past that, the setup the idea described is not the
# setup in front of you. Unfilled ideas are excluded from the win rate: they are
# trades that did not happen, not flat trades.
#fill_window_days = 3

# Optional keyed data providers. Yahoo needs no key; these enrich the packs.
#[providers]
#contact_email    = "you@example.com"  # sent to SEC EDGAR as User-Agent contact
#alphavantage_key = ""
#fred_key         = ""

# Alpaca Markets: daily bars and Benzinga headlines for US listings.
#
# Read-only market data — paper-trading keys are sufficient and are the safer
# credential to put here, since they cannot place an order. Both halves are
# needed; with neither set, prices and news fall back to Yahoo exactly as before.
#
# Why it is worth setting: Yahoo's chart endpoint is one request per ticker, so a
# universe-wide pre-screen fires ~272 of them per run and this host has been
# answered with HTTP 429 on every Yahoo endpoint as a result. Alpaca serves many
# symbols per request — 154 US names in 2 calls — which both restores the US half
# of the universe and takes the load off Yahoo for the foreign half, which nothing
# else can reach. Alpaca is US-only: eu50 and asia100 stay on Yahoo, as do index
# benchmarks (^GSPC, ^N225, …) and FX pairs.
#
# The free "Basic" plan is enough: daily bars back to 2016 and news back to 2015,
# 200 requests a minute. Bars are always requested on the consolidated SIP feed,
# never IEX. Measured over the 119 US universe names, IEX reports dollar volume a
# median 24x too small (11.8x-49.1x) while returning HTTP 200 and closes matching
# SIP to a few cents; 13 of those 119 mega-caps then fall under the $20M ADV floor
# and vanish from the pre-screen, looking like a perfectly normal result.
#
# Env: APCA_API_KEY_ID / APCA_API_SECRET_KEY (Alpaca's own names), or
# CFR_ALPACA_KEY_ID / CFR_ALPACA_SECRET_KEY, which take precedence.
#alpaca_key_id     = ""
#alpaca_secret_key = ""

# Complete assembled prompt / response limits in UTF-8 bytes. These do not
# increase api.max_tokens or chief_fallback.max_tokens. Estimates are recorded
# separately from provider usage. Environment names use
# CFR_RESEARCH_<TRIAGE|RESEARCHER|CHALLENGER|CHIEF>_<INPUT_BYTES|RESPONSE_BYTES>.
#[research.budgets.triage]
#input_bytes = 98304
#response_bytes = 12288
#[research.budgets.researcher]
#input_bytes = 98304
#response_bytes = 20480
#[research.budgets.challenger]
#input_bytes = 98304
#response_bytes = 12288
#[research.budgets.chief]
#input_bytes = 196608
#response_bytes = 24576
