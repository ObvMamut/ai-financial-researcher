# Claude Financial Researcher configuration.
#
# Copy to ./cfr.toml (project-local) or ~/.config/cfr/config.toml (global).
# Precedence, lowest to highest: built-in defaults → ~/.config/cfr/config.toml
# → ./cfr.toml → environment variables (CFR_*) → command-line flags (headless).
# Every key is optional; omit anything to keep the default.

# Where run artifacts (reports, ideas.json, prices/, quant.json) are written.
#runs_dir = "runs"

# Where agent persona prompts live.
#agents_dir = "agents"

# Cache directory for market data (daily-keyed Yahoo responses).
#data_dir = ".data"

# How many past run directories to keep (the scoreboard reads this history).
#keep_runs = 100

# How long a cached daily price series is served before being refetched. Every
# entry, stop and target is computed to the cent off the last close, so a cache
# scoped only to the calendar day priced a Saturday run off Thursday's bar.
#price_ttl = "4h"

# How long cached provider responses survive the run-start janitor. Keys are
# date-scoped, so older entries can never be read again — they only accumulate.
# 0 disables pruning.
#data_cache_days = 7

# Bounded worker pool size for parallel agent subprocesses.
#workers = 4

# ── Funnel geometry ──────────────────────────────────────────────────────────
# Stage 0.5 ranks every constituent of the selected indices on a computed quant
# composite before any model is called; the scouts screen that ranking.

# How many of each index's highest-composite names the scout's table shows. The
# five weakest are always appended as short candidates.
#prescreen_top_per_index = 15

# Cap on the merged shortlist that reaches the specialists, and on how many of
# those names one index may contribute before the merit backfill.
#max_shortlist = 12
#max_per_index = 5

# Default indices screened by independent research (empty/omitted = all four).
# Valid keys: sp500, nq100, eu50, asia100. The TUI picker overrides this per run.
#indices = ["sp500", "eu50"]

# Max simultaneous Gemini (agy) subprocesses. Keep at 1 unless your OS keyring
# tolerates concurrent auth (contention escalates to a browser login). Ignored
# when cheap_engine = "api" (the HTTP engine has no keyring and parallelizes freely).
#gemini_concurrency = 1

# Which engine runs the cheap-research roles (scouts + the 5 specialists):
#   "gemini" — the `agy` CLI (default; no key needed)
#   "api"    — a remote OpenAI-compatible HTTP endpoint (see [api] below).
#              Recommended if `agy`/Gemini is unreliable for you.
#   "local"  — a local OpenAI-compatible server such as Ollama (see [local] below).
#              Free and offline; needs a GPU/CPU that can serve the model.
# The heavy Chief Analyst synthesis always uses the `claude` CLI, so the
# cheap/heavy split is preserved whichever cheap engine you pick.
#cheap_engine = "gemini"

# Max simultaneous local-model calls (cheap_engine = "local"). One GPU can't run
# the 5 specialists at once, so keep this at 1 unless you have plenty of VRAM.
#local_concurrency = 1

# Domain weights for confluence scoring; they are renormalized, so only the
# ratios matter.
#[weights]
#fundamentals = 0.30
#quant        = 0.20
#news         = 0.20
#macro        = 0.15
#sentiment    = 0.15

# Per-stage subprocess timeouts (Go duration strings).
#[timeouts]
#screening = "5m"
#analysis  = "8m"
#synthesis = "10m"

# Subprocess retry policy.
#[retry]
#max_attempts = 2
#base_delay   = "2s"
#max_delay    = "30s"
#jitter       = true

# Model names passed to each CLI via --model.
#[models]
#claude = "opus"
#gemini = ""

# CLI executables (same as CFR_CLAUDE_BIN / CFR_GEMINI_BIN).
#[binaries]
#claude = "claude"
#gemini = "agy"

# OpenAI-compatible cheap-research engine (used when cheap_engine = "api"). This
# is the recommended replacement if `agy`/Gemini stops working. It speaks the
# standard /chat/completions protocol, so it works with DeepSeek, OpenRouter,
# OpenAI, or a local vLLM/Ollama gateway — just change base_url + model. Only the
# cheap roles use it; the Chief Analyst still synthesises via the `claude` CLI.
# The agy keyring throttle does NOT apply here, so the 5 specialists run in
# parallel — set workers >= 5 to run them all at once.
# Put the key in the CFR_API_KEY env var (or DEEPSEEK_API_KEY); avoid committing
# it to this file.
#[api]
#base_url = "https://api.deepseek.com"   # up to, not including, /chat/completions
#model    = "deepseek-chat"
#api_key  = ""                            # prefer CFR_API_KEY / DEEPSEEK_API_KEY env
# Completion cap. A response cut off at the provider's default limit loses its
# structured tail, which the pipeline read as "this domain scored nobody"; the
# engine now treats finish_reason=length as a failure and retries.
#max_tokens = 8192

# Local OpenAI-compatible server (used when cheap_engine = "local"). Same engine
# as [api], just pointed at your machine — free and offline. Easiest server is
# Ollama (`ollama serve` → http://localhost:11434/v1); llama.cpp/LM Studio/vLLM
# work too by changing base_url. No key needed (local servers don't authenticate).
# On ~4 GB VRAM a Q4 7–8B instruct model is the sweet spot; confirm with nvidia-smi.
#[local]
#base_url = "http://localhost:11434/v1"   # Ollama's OpenAI-compatible endpoint
#model    = "qwen2.5:7b-instruct"         # must match a model you've pulled
#api_key  = ""                            # optional; ignored by most local servers

# No-API alternative: run the cheap role on the `claude` CLI at a cheap tier.
# Keep cheap_engine = "gemini" and just swap the "gemini"-role binary+model —
# this preserves the cheap/heavy split (Haiku for the parallel research calls,
# Opus for the single Chief Analyst synthesis):
#   [binaries]
#   gemini = "claude"
#   [models]
#   gemini = "haiku"
# The agy keyring-contention reason is then gone, so raise gemini_concurrency > 1.

# ── Risk limits ──────────────────────────────────────────────────────────────
#[risk]
# 20-day average dollar volume below which a name is not tradeable in size. The
# pre-screen drops anything under it, so such names never reach a model.
#adv_min_usd = 20000000

# Optional keyed data providers. Yahoo needs no key; these enrich the packs.
#[providers]
#contact_email    = "you@example.com"  # sent to SEC EDGAR as User-Agent contact
#alphavantage_key = ""
#fred_key         = ""
